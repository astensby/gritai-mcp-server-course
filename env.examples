# =============================================================================
# GritAI MCP Server Examples - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Example 4: API Key Auth (Investment Data) Server
# -----------------------------------------------------------------------------
# Alpha Vantage API key for stock ticker search
# Get your free API key at: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY="your_alphavantage_api_key_here"

# -----------------------------------------------------------------------------
# Example 5: AWS Knowledge Base Server
# -----------------------------------------------------------------------------
# AWS Bedrock Knowledge Base ID
KNOWLEDGE_BASE_ID="your_aws_knowledge_base_id"

# AWS Region where your Knowledge Base is located
AWS_REGION="us-east-1"

# AWS Profile name for SSO authentication (configured via aws configure sso)
# Make sure you're logged in with: aws sso login --profile <your-profile-name>
AWS_PROFILE="your-aws-sso-profile"

# -----------------------------------------------------------------------------
# Example 6: Local RAG Server (PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
# AWS Configuration (for Bedrock embeddings)
AWS_REGION="eu-west-1"
AWS_PROFILE="your-aws-sso-profile"

# PostgreSQL Database Configuration
PGVECTOR_DB_NAME="vectordb"
PGVECTOR_DB_USER="your_db_username"
PGVECTOR_DB_PASSWORD="your_db_password"
PGVECTOR_DB_HOST="localhost"
PGVECTOR_DB_PORT="5432"

# -----------------------------------------------------------------------------
# Example 7: Azure AI Search Server
# -----------------------------------------------------------------------------
# Azure AI Search Service Endpoint
AZURE_SEARCH_ENDPOINT="https://your-service.search.windows.net"

# Azure AI Search Index Name
AZURE_SEARCH_INDEX="your-index-name"

# Azure AI Search API Key (Optional - omit to use DefaultAzureCredential)
# If not provided, the server will use DefaultAzureCredential (Azure CLI, Managed Identity, etc.)
# Make sure you've run: az login (if using Azure CLI)
AZURE_SEARCH_KEY="your_azure_search_api_key"

# -----------------------------------------------------------------------------
# Example 8: Azure OAuth Remote Server
# -----------------------------------------------------------------------------
# Enable/disable OAuth authentication (set to "0" to disable, "1" to enable)
ENABLE_OIDC="1"

# Azure Tenant ID (required if OAuth enabled)
AZURE_TENANT_ID="your-azure-tenant-id"

# Azure App Registration Client ID (required if OAuth enabled)
OIDC_CLIENT_ID="your-azure-app-client-id"

# Azure App Registration Client Secret (required if OAuth enabled)
OIDC_CLIENT_SECRET="your-azure-app-client-secret"

# Public base URL of your deployed server (required if OAuth enabled)
# Must match the redirect URI configured in Azure App Registration
PUBLIC_BASE_URL="https://your-app-url.com"

# OAuth Redirect Path (optional, defaults to "/auth/callback")
OIDC_REDIRECT_PATH="/auth/callback"

# Allowed redirect URIs (optional, comma-separated)
# Defaults to common localhost patterns if not specified
OIDC_ALLOWED_REDIRECT_URIS="http://localhost:*/*,http://127.0.0.1:*/*"

# Required OAuth scopes (optional, space-separated)
# Defaults to: User.Read email openid profile offline_access
OIDC_REQUIRED_SCOPES="User.Read email openid profile offline_access"

# -----------------------------------------------------------------------------
# Example 1 Remote / HTTP Servers (Optional)
# -----------------------------------------------------------------------------
# Port for HTTP-based MCP servers (optional, defaults to 8000)
PORT="8000"

